{
  "name": "wechat-chatgpt",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "export": "dist/main.js",
  "scripts": {
    "dev": "nodemon --exec node --watch config.yaml --loader ts-node/esm src/main.ts",
    "build": "tsc --build --clean && tsc",
    "start": "node dist/main.js",
    "analyze-bundle": "npm ls --depth=0",
    "security-audit": "npm audit --audit-level=high"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "async-retry": "^1.3.3",
    "chatgpt": "^5.2.5",
    "dotenv": "^16.4.7",
    "execa": "^9.6.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0",
    "wechaty": "^1.20.2",
    "wechaty-puppet-wechat": "^1.18.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.9",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "nodemonConfig": {
    "watch": "src",
    "ext": "ts",
    "exec": "node --loader ts-node/esm src/main.ts",
    "delay": 500
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  }
}
