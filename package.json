{
  "name": "wechat-chatgpt",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "export": "dist/main.js",
  "scripts": {
    "dev": "nodemon --exec node --watch config.yaml --loader ts-node/esm src/main.ts",
    "build": "tsc",
    "build:prod": "tsc && npm run optimize",
    "optimize": "node scripts/optimize.js",
    "analyze": "node scripts/analyze-bundle.js",
    "test:perf": "node scripts/test-performance.js",
    "monitor": "node scripts/monitor-performance.js",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node --max-old-space-size=512 dist/main.js",
    "docker:build": "docker build -f Dockerfile.prod -t wechat-chatgpt:prod .",
    "docker:run": "docker run --env-file .env -p 3000:3000 wechat-chatgpt:prod"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "async-retry": "^1.3.3",
    "chatgpt": "^3.5.2",
    "dotenv": "^16.0.3",
    "execa": "^6.1.0",
    "qrcode": "^1.5.1",
    "uuid": "^9.0.0",
    "wechaty": "^1.20.2",
    "wechaty-puppet-wechat": "^1.18.4",
    "yaml": "^2.1.3"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.5",
    "@types/qrcode": "^1.5.0",
    "@types/uuid": "^9.0.0",
    "nodemon": "^2.0.20",
    "ts-node": "^10.9.1",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "nodemonConfig": {
    "watch": "src",
    "ext": "ts",
    "exec": "node --loader ts-node/esm src/main.ts",
    "delay": 500
  },
  "type": "module"
}
