{
  "name": "wechat-chatgpt",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "export": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec node --watch config.yaml --loader ts-node/esm src/main.ts",
    "build": "tsc --build",
    "build:fast": "tsc --build --incremental",
    "build:clean": "rm -rf dist .tsbuildinfo && tsc --build",
    "build:watch": "tsc --build --watch",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node --max-old-space-size=4096 dist/main.js",
    "analyze": "npx tsx src/analyze-bundle.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "async-retry": "^1.3.3",
    "chatgpt": "^3.5.2",
    "dotenv": "^16.0.3",
    "execa": "^6.1.0",
    "qrcode": "^1.5.1",
    "uuid": "^9.0.0",
    "wechaty": "^1.20.2",
    "wechaty-puppet-wechat": "^1.18.4",
    "yaml": "^2.1.3"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.5",
    "@types/qrcode": "^1.5.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "nodemon": "^2.0.20",
    "tsx": "^4.0.0",
    "ts-node": "^10.9.1"
  },
  "nodemonConfig": {
    "watch": ["src", "config.yaml"],
    "ext": "ts,js,yaml",
    "exec": "node --loader ts-node/esm src/main.ts",
    "delay": 500,
    "ignore": ["dist/**/*", ".tsbuildinfo"]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
